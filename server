const http = require('http');
const fs = require('fs');
const path = require('path');
const WebSocket = require('ws');

const PORT = process.env.PORT || 3000;
const ROOT = __dirname;

const MAX_PLAYERS = 6;
const TEAM_SIZE = 3;

const rooms = new Map();

const ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';

function generateRoomCode() {
  let s = '';

  do {
    s = Array.from(
      { length: 5 },
      () => ALPHABET[Math.floor(Math.random() * ALPHABET.length)]
    ).join('');
  } while (rooms.has(s));

  return s;
}

function generateId(prefix = 'player') {
  return `${prefix}_${Math.random().toString(36).slice(2)}_${Date.now().toString(36)}`;
}

function send(ws, obj) {
  if (ws && ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify(obj));
  }
}

function broadcast(room, obj, exceptWs = null) {
  for (const player of room.players.values()) {
    if (player.ws !== exceptWs) {
      send(player.ws, obj);
    }
  }
}

function getTeamForSlot(slot) {
  return slot < TEAM_SIZE ? 0 : 1;
}

function getPlayersArray(room) {
  return [...room.players.values()]
    .sort((a, b) => a.slot - b.slot)
    .map(player => ({
      id: player.id,
      slot: player.slot,
      name: player.name,
      team: player.team,
      host: player.host,
      bot: player.bot
    }));
}

function roomState(room) {
  return getPlayersArray(room);
}

function sendLobby(room) {
  broadcast(room, {
    type: 'lobby',
    code: room.code,
    host: room.hostId,
    players: roomState(room),
    started: room.started,
    maxPlayers: MAX_PLAYERS,
    teamSize: TEAM_SIZE
  });
}

function getFreeSlot(room) {
  for (let slot = 0; slot < MAX_PLAYERS; slot++) {
    const occupied = [...room.players.values()].some(
      player => player.slot === slot
    );

    if (!occupied) {
      return slot;
    }
  }

  return -1;
}

function getTeamPlayerCount(room, team) {
  return [...room.players.values()].filter(
    player => player.team === team
  ).length;
}

/*
 * Ajoute automatiquement des bots jusqu'à avoir 3 joueurs
 * dans chaque équipe.
 *
 * Les bots n'ont pas de WebSocket.
 * Ils seront pilotés par le client hôte dans la simulation.
 */
function fillBots(room) {
  if (room.started) return;

  for (let team = 0; team < 2; team++) {
    while (getTeamPlayerCount(room, team) < TEAM_SIZE) {
      const slot = [...Array(MAX_PLAYERS).keys()]
        .filter(s => getTeamForSlot(s) === team)
        .find(s => ![...room.players.values()].some(p => p.slot === s));

      if (slot === undefined) {
        break;
      }

      const bot = {
        id: generateId('bot'),
        ws: null,
        room,
        slot,
        name: `Bot ${team + 1}-${getTeamPlayerCount(room, team) + 1}`,
        team,
        host: false,
        bot: true
      };

      room.players.set(bot.id, bot);
    }
  }
}

function removeBots(room) {
  for (const [id, player] of room.players) {
    if (player.bot) {
      room.players.delete(id);
    }
  }
}

function closePlayer(room, player) {
  if (!room || !player) return;

  room.players.delete(player.id);

  /*
   * Si l'hôte quitte, on cherche un autre vrai joueur.
   * Un bot ne peut jamais devenir hôte.
   */
  if (room.hostId === player.id) {
    const newHost = [...room.players.values()].find(
      p => !p.bot && p.ws
    );

    room.hostId = newHost ? newHost.id : null;

    for (const p of room.players.values()) {
      p.host = p.id === room.hostId;
    }

    if (newHost) {
      send(newHost.ws, {
        type: 'host_changed',
        host: newHost.id
      });
    }
  }

  if (room.players.size === 0) {
    rooms.delete(room.code);
    return;
  }

  /*
   * Avant le lancement, on retire les anciens bots afin
   * que de vrais joueurs puissent prendre leur place.
   */
  if (!room.started) {
    removeBots(room);
  }

  sendLobby(room);
}

